<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24765" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24765"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-2" userLabel="File's Owner"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <tableCellView identifier="BookmarkCell" wantsLayer="YES" id="repo-cell" customClass="SidebarRepositoryCellView" customModule="gitui" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="220" height="58"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <customView translatesAutoresizingMaskIntoConstraints="NO" id="repo-divider">
                    <rect key="frame" x="16" y="57" width="188" height="1"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="1" id="repo-divider-h"/>
                    </constraints>
                </customView>
                <stackView distribution="fill" orientation="vertical" alignment="leading" spacing="4" horizontalStackHuggingPriority="249.99998474121094" verticalStackHuggingPriority="249.99998474121094" translatesAutoresizingMaskIntoConstraints="NO" id="repo-content-stack">
                    <rect key="frame" x="8" y="10" width="204" height="35"/>
                    <subviews>
                        <stackView distribution="fill" orientation="horizontal" alignment="centerY" spacing="7" horizontalStackHuggingPriority="249.99998474121094" verticalStackHuggingPriority="249.99998474121094" translatesAutoresizingMaskIntoConstraints="NO" id="repo-title-stack">
                            <rect key="frame" x="0.0" y="19" width="204" height="16"/>
                            <subviews>
                                <imageView translatesAutoresizingMaskIntoConstraints="NO" id="repo-icon">
                                    <rect key="frame" x="0.0" y="1" width="14" height="14"/>
                                    <constraints>
                                        <constraint firstAttribute="height" constant="14" id="repo-icon-h"/>
                                        <constraint firstAttribute="width" constant="14" id="repo-icon-w"/>
                                    </constraints>
                                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyDown" id="repo-icon-cell"/>
                                </imageView>
                                <textField focusRingType="none" horizontalHuggingPriority="249" verticalHuggingPriority="750" horizontalCompressionResistancePriority="749" translatesAutoresizingMaskIntoConstraints="NO" id="repo-name">
                                    <rect key="frame" x="19" y="0.0" width="130" height="16"/>
                                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="Repository Name" id="repo-name-cell">
                                        <font key="font" metaFont="system"/>
                                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                                <textField focusRingType="none" horizontalHuggingPriority="252" verticalHuggingPriority="750" horizontalCompressionResistancePriority="752" translatesAutoresizingMaskIntoConstraints="NO" id="repo-stats">
                                    <rect key="frame" x="152" y="0.0" width="54" height="16"/>
                                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" id="repo-stats-cell">
                                        <font key="font" metaFont="message" size="13"/>
                                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    </textFieldCell>
                                </textField>
                            </subviews>
                            <visibilityPriorities>
                                <integer value="1000"/>
                                <integer value="1000"/>
                                <integer value="1000"/>
                            </visibilityPriorities>
                            <customSpacing>
                                <real value="3.4028234663852886e+38"/>
                                <real value="3.4028234663852886e+38"/>
                                <real value="3.4028234663852886e+38"/>
                            </customSpacing>
                        </stackView>
                        <textField focusRingType="none" horizontalHuggingPriority="249" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="repo-path">
                            <rect key="frame" x="-2" y="0.0" width="208" height="15"/>
                            <textFieldCell key="cell" lineBreakMode="truncatingHead" title="/Users/example/repository" id="repo-path-cell">
                                <font key="font" metaFont="cellTitle"/>
                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                    </subviews>
                    <constraints>
                        <constraint firstItem="repo-path" firstAttribute="width" secondItem="repo-content-stack" secondAttribute="width" id="repo-path-w"/>
                        <constraint firstItem="repo-title-stack" firstAttribute="width" secondItem="repo-content-stack" secondAttribute="width" id="repo-title-stack-w"/>
                    </constraints>
                    <visibilityPriorities>
                        <integer value="1000"/>
                        <integer value="1000"/>
                    </visibilityPriorities>
                    <customSpacing>
                        <real value="3.4028234663852886e+38"/>
                        <real value="3.4028234663852886e+38"/>
                    </customSpacing>
                </stackView>
            </subviews>
            <constraints>
                <constraint firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="repo-content-stack" secondAttribute="bottom" constant="4" id="repo-content-b"/>
                <constraint firstItem="repo-content-stack" firstAttribute="leading" secondItem="repo-cell" secondAttribute="leading" constant="8" id="repo-content-l"/>
                <constraint firstAttribute="trailing" secondItem="repo-content-stack" secondAttribute="trailing" constant="8" id="repo-content-r"/>
                <constraint firstItem="repo-content-stack" firstAttribute="top" secondItem="repo-cell" secondAttribute="top" constant="13" id="repo-content-t"/>
                <constraint firstItem="repo-divider" firstAttribute="leading" secondItem="repo-cell" secondAttribute="leading" constant="16" id="repo-divider-l"/>
                <constraint firstAttribute="trailing" secondItem="repo-divider" secondAttribute="trailing" constant="16" id="repo-divider-r"/>
                <constraint firstItem="repo-divider" firstAttribute="top" secondItem="repo-cell" secondAttribute="top" id="repo-divider-t"/>
            </constraints>
            <connections>
                <outlet property="dividerView" destination="repo-divider" id="out-divider"/>
                <outlet property="imageView" destination="repo-icon" id="out-image"/>
                <outlet property="pathLabel" destination="repo-path" id="out-path"/>
                <outlet property="repoIcon" destination="repo-icon" id="out-repo-icon"/>
                <outlet property="statsLabel" destination="repo-stats" id="out-stats"/>
                <outlet property="textField" destination="repo-name" id="out-text"/>
            </connections>
            <point key="canvasLocation" x="140" y="81"/>
        </tableCellView>
    </objects>
</document>
