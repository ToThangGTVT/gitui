<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24765" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24765"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSTableCellView"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <tableCellView identifier="fileDetailCell" id="cell-view-id" customClass="FileDetailCell" customModule="gitui" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="250" height="24"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="status-badge">
                    <rect key="frame" x="4" y="4" width="22" height="16"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="16" id="badge-h"/>
                        <constraint firstAttribute="width" constant="18" id="badge-w"/>
                    </constraints>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="center" id="badge-cell" customClass="CenteredTextFieldCell" customModule="gitui" customModuleProvider="target">
                        <font key="font" metaFont="systemBold" size="10"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" translatesAutoresizingMaskIntoConstraints="NO" id="file-path-label">
                    <rect key="frame" x="30" y="5" width="216" height="14"/>
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="File Path" id="path-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <constraints>
                <constraint firstItem="status-badge" firstAttribute="centerY" secondItem="cell-view-id" secondAttribute="centerY" id="c-badge-cy"/>
                <constraint firstItem="status-badge" firstAttribute="leading" secondItem="cell-view-id" secondAttribute="leading" constant="6" id="c-badge-l"/>
                <constraint firstItem="file-path-label" firstAttribute="centerY" secondItem="cell-view-id" secondAttribute="centerY" id="c-label-cy"/>
                <constraint firstItem="file-path-label" firstAttribute="leading" secondItem="status-badge" secondAttribute="trailing" constant="8" id="c-label-l"/>
                <constraint firstItem="file-path-label" firstAttribute="trailing" secondItem="cell-view-id" secondAttribute="trailing" constant="-6" id="c-label-r"/>
            </constraints>
            <connections>
                <outlet property="statusBadge" destination="status-badge" id="out-badge"/>
                <outlet property="textField" destination="file-path-label" id="out-text"/>
            </connections>
            <point key="canvasLocation" x="140" y="154"/>
        </tableCellView>
    </objects>
</document>
