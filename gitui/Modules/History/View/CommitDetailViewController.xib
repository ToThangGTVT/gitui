<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24765" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24765"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="CommitDetailViewController" customModule="gitui" customModuleProvider="target">
            <connections>
                <outlet property="authorLabel" destination="author-lbl" id="out-author"/>
                <outlet property="avatarView" destination="avatar-view" id="out-avatar"/>
                <outlet property="changedFilesTableView" destination="files-table" id="out-files"/>
                <outlet property="dateLabel" destination="date-lbl" id="out-date"/>
                <outlet property="hashPill" destination="hash-pill" id="out-hash"/>
                <outlet property="messageTextView" destination="message-text" id="out-message"/>
                <outlet property="view" destination="c22-O7-iKe" id="out-view"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="c22-O7-iKe">
            <rect key="frame" x="0.0" y="0.0" width="300" height="600"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="hash-pill">
                    <rect key="frame" x="14" y="570" width="99" height="18"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="18" id="hash-h"/>
                        <constraint firstAttribute="width" constant="95" id="hash-w"/>
                    </constraints>
                    <textFieldCell key="cell" lineBreakMode="clipping" alignment="center" title="COMMIT HASH" id="hash-cell">
                        <font key="font" size="10" name="Menlo-Regular"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="windowBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <customView translatesAutoresizingMaskIntoConstraints="NO" id="avatar-view" customClass="AvatarView" customModule="gitui" customModuleProvider="target">
                    <rect key="frame" x="16" y="522" width="36" height="36"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="36" id="avatar-h"/>
                        <constraint firstAttribute="width" constant="36" id="avatar-w"/>
                    </constraints>
                </customView>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="author-lbl">
                    <rect key="frame" x="60" y="541" width="226" height="16"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Author" id="author-cell">
                        <font key="font" metaFont="systemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="date-lbl">
                    <rect key="frame" x="60" y="525" width="226" height="14"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="Date" id="date-cell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <scrollView borderType="none" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" translatesAutoresizingMaskIntoConstraints="NO" id="message-scroll">
                    <rect key="frame" x="16" y="430" width="268" height="80"/>
                    <clipView key="contentView" drawsBackground="NO" id="msg-clip">
                        <rect key="frame" x="0.0" y="0.0" width="268" height="80"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView editable="NO" importsGraphics="NO" verticallyResizable="NO" spellingCorrection="YES" smartInsertDelete="YES" id="message-text">
                                <rect key="frame" x="0.0" y="0.0" width="268" height="80"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <size key="minSize" width="268" height="80"/>
                                <size key="maxSize" width="463" height="10000000"/>
                                <color key="insertionPointColor" name="textColor" catalog="System" colorSpace="catalog"/>
                            </textView>
                        </subviews>
                    </clipView>
                    <constraints>
                        <constraint firstAttribute="height" constant="80" id="msg-h"/>
                    </constraints>
                </scrollView>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="files-title">
                    <rect key="frame" x="14" y="401" width="88" height="13"/>
                    <textFieldCell key="cell" lineBreakMode="clipping" title="CHANGED FILES" id="files-title-cell">
                        <font key="font" metaFont="systemBold" size="10"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <scrollView autohidesScrollers="YES" horizontalLineScroll="24" horizontalPageScroll="10" verticalLineScroll="24" verticalPageScroll="10" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="files-scroll">
                    <rect key="frame" x="16" y="12" width="268" height="381"/>
                    <clipView key="contentView" id="files-clip">
                        <rect key="frame" x="1" y="1" width="266" height="379"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnReordering="NO" columnResizing="NO" multipleSelection="NO" emptySelection="NO" autosaveColumns="NO" rowHeight="24" viewBased="YES" id="files-table">
                                <rect key="frame" x="0.0" y="0.0" width="266" height="379"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <size key="intercellSpacing" width="17" height="0.0"/>
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                <tableColumns>
                                    <tableColumn identifier="fileCol" width="249" minWidth="40" maxWidth="1000" id="file-col">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" editable="YES" title="Text Cell" id="file-data-cell"/>
                                    </tableColumn>
                                </tableColumns>
                            </tableView>
                        </subviews>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="files-hscroll">
                        <rect key="frame" x="1" y="360" width="266" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="files-vscroll">
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    </scroller>
                </scrollView>
            </subviews>
            <constraints>
                <constraint firstItem="author-lbl" firstAttribute="leading" secondItem="avatar-view" secondAttribute="trailing" constant="10" id="c-author-l"/>
                <constraint firstItem="author-lbl" firstAttribute="trailing" secondItem="c22-O7-iKe" secondAttribute="trailing" constant="-16" id="c-author-r"/>
                <constraint firstItem="author-lbl" firstAttribute="top" secondItem="avatar-view" secondAttribute="top" constant="1" id="c-author-t"/>
                <constraint firstItem="avatar-view" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="16" id="c-avatar-l"/>
                <constraint firstItem="avatar-view" firstAttribute="top" secondItem="hash-pill" secondAttribute="bottom" constant="12" id="c-avatar-t"/>
                <constraint firstItem="date-lbl" firstAttribute="leading" secondItem="avatar-view" secondAttribute="trailing" constant="10" id="c-date-l"/>
                <constraint firstItem="date-lbl" firstAttribute="trailing" secondItem="c22-O7-iKe" secondAttribute="trailing" constant="-16" id="c-date-r"/>
                <constraint firstItem="date-lbl" firstAttribute="top" secondItem="author-lbl" secondAttribute="bottom" constant="2" id="c-date-t"/>
                <constraint firstItem="files-scroll" firstAttribute="bottom" secondItem="c22-O7-iKe" secondAttribute="bottom" constant="-12" id="c-files-scroll-b"/>
                <constraint firstItem="files-scroll" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="16" id="c-files-scroll-l"/>
                <constraint firstItem="files-scroll" firstAttribute="trailing" secondItem="c22-O7-iKe" secondAttribute="trailing" constant="-16" id="c-files-scroll-r"/>
                <constraint firstItem="files-scroll" firstAttribute="top" secondItem="files-title" secondAttribute="bottom" constant="8" id="c-files-scroll-t"/>
                <constraint firstItem="files-title" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="16" id="c-files-title-l"/>
                <constraint firstItem="files-title" firstAttribute="top" secondItem="message-scroll" secondAttribute="bottom" constant="16" id="c-files-title-t"/>
                <constraint firstItem="hash-pill" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="16" id="c-hash-l"/>
                <constraint firstItem="hash-pill" firstAttribute="top" secondItem="c22-O7-iKe" secondAttribute="top" constant="12" id="c-hash-t"/>
                <constraint firstItem="message-scroll" firstAttribute="leading" secondItem="c22-O7-iKe" secondAttribute="leading" constant="16" id="c-msg-l"/>
                <constraint firstItem="message-scroll" firstAttribute="trailing" secondItem="c22-O7-iKe" secondAttribute="trailing" constant="-16" id="c-msg-r"/>
                <constraint firstItem="message-scroll" firstAttribute="top" secondItem="avatar-view" secondAttribute="bottom" constant="12" id="c-msg-t"/>
            </constraints>
            <point key="canvasLocation" x="140" y="154"/>
        </customView>
    </objects>
</document>
