                <outlet property="scrollView" destination="scroll-view" id="out-scroll"/>
                <outlet property="stackView" destination="stack-view" id="out-stack"/>
                <outlet property="resolveContainer" destination="res-cont" id="out-res"/>
                <outlet property="resolveButton" destination="res-btn" id="out-btn"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="c22-O7-iKe">
            <rect key="frame" x="0.0" y="0.0" width="800" height="600"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <scrollView borderType="none" autohidesScrollers="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="scroll-view">
                    <rect key="frame" x="0.0" y="50" width="800" height="550"/>
                    <clipView key="contentView" drawsBackground="NO" id="clip-view">
                        <rect key="frame" x="0.0" y="0.0" width="800" height="550"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view translatesAutoresizingMaskIntoConstraints="NO" id="doc-view">
                                <rect key="frame" x="0.0" y="0.0" width="800" height="550"/>
                                <subviews>
                                    <stackView distribution="fill" orientation="vertical" alignment="leading" spacing="0.0" horizontalStackHuggingPriority="249.99998474121094" verticalStackHuggingPriority="249.99998474121094" detachesHiddenViews="YES" translatesAutoresizingMaskIntoConstraints="NO" id="stack-view">
                                        <rect key="frame" x="0.0" y="0.0" width="800" height="550"/>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="stack-view" firstAttribute="leading" secondItem="doc-view" secondAttribute="leading" id="c-stk-l"/>
                                    <constraint firstItem="stack-view" firstAttribute="trailing" secondItem="doc-view" secondAttribute="trailing" id="c-stk-r"/>
                                    <constraint firstItem="stack-view" firstAttribute="top" secondItem="doc-view" secondAttribute="top" id="c-stk-t"/>
                                    <constraint firstItem="stack-view" firstAttribute="bottom" secondItem="doc-view" secondAttribute="bottom" id="c-stk-b"/>
                                </constraints>
                            </view>
                        </subviews>
                        <constraints>
                            <constraint firstItem="doc-view" firstAttribute="leading" secondItem="clip-view" secondAttribute="leading" id="c-doc-l"/>
                            <constraint firstItem="doc-view" firstAttribute="trailing" secondItem="clip-view" secondAttribute="trailing" id="c-doc-r"/>
                            <constraint firstItem="doc-view" firstAttribute="top" secondItem="clip-view" secondAttribute="top" id="c-doc-t"/>
                        </constraints>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="h-scroll">
                        <rect key="frame" x="-100" y="-100" width="784" height="16"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" wantsLayer="YES" verticalHuggingPriority="750" horizontal="NO" id="v-scroll">
                        <rect key="frame" x="784" y="0.0" width="16" height="550"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                </scrollView>
                <customView translatesAutoresizingMaskIntoConstraints="NO" id="res-cont">
                    <rect key="frame" x="0.0" y="0.0" width="800" height="50"/>
