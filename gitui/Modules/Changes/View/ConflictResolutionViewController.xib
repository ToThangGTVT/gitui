                        <constraint firstItem="res-border" firstAttribute="trailing" secondItem="res-cont" secondAttribute="trailing" id="c-bdr-r"/>
                        <constraint firstItem="res-border" firstAttribute="top" secondItem="res-cont" secondAttribute="top" id="c-bdr-t"/>
                        <constraint firstAttribute="trailing" secondItem="res-btn" secondAttribute="trailing" constant="16" id="c-btn-r"/>
                        <constraint firstItem="res-btn" firstAttribute="centerY" secondItem="res-cont" secondAttribute="centerY" id="c-btn-cy"/>
