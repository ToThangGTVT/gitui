                                                        <rect key="frame" x="322" y="8" width="22" height="17"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="18" id="cell-check-w"/>
                                                        </constraints>
                                                        <textFieldCell key="cell" lineBreakMode="clipping" alignment="right" title="✓" id="cell-check-cell">
                                                            <font key="font" metaFont="systemBold" size="14"/>
                                                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                        </textFieldCell>
                                                    </textField>
                                                </subviews>
                                                <constraints>
                                                    <constraint firstItem="cell-check" firstAttribute="centerY" secondItem="cell-view-1" secondAttribute="centerY" id="c-check-cy"/>
                                                    <constraint firstAttribute="trailing" secondItem="cell-check" secondAttribute="trailing" constant="10" id="c-check-r"/>
                                                    <constraint firstItem="cell-icon" firstAttribute="centerY" secondItem="cell-view-1" secondAttribute="centerY" id="c-icon-cy"/>
                                                    <constraint firstItem="cell-icon" firstAttribute="leading" secondItem="cell-view-1" secondAttribute="leading" constant="12" id="c-icon-l"/>
                                                    <constraint firstItem="cell-label" firstAttribute="centerY" secondItem="cell-view-1" secondAttribute="centerY" id="c-label-cy"/>
                                                    <constraint firstItem="cell-label" firstAttribute="leading" secondItem="cell-icon" secondAttribute="trailing" constant="8" id="c-label-l"/>
                                                    <constraint firstItem="cell-check" firstAttribute="leading" secondItem="cell-label" secondAttribute="trailing" constant="4" id="c-label-r"/>
                                                </constraints>
                                                <connections>
                                                    <outlet property="imageView" destination="cell-icon" id="conn-img"/>
                                                    <outlet property="textField" destination="cell-label" id="conn-txt"/>
                                                </connections>
                                            </tableCellView>
                                        </prototypeCellViews>
                                    </tableColumn>
                                </tableColumns>
                            </tableView>
                        </subviews>
                        <nil key="backgroundColor"/>
                    </clipView>
                    <scroller key="horizontalScroller" wantsLayer="YES" verticalHuggingPriority="750" horizontal="YES" id="h-scroller">
                        <rect key="frame" x="0.0" y="271" width="348" height="17"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    </scroller>
