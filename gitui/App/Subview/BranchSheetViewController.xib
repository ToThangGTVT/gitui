                                                <rect key="frame" x="10" y="0.0" width="352" height="32"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <subviews>
                                                    <imageView horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="cell-icon">
                                                        <rect key="frame" x="12" y="2" width="18" height="29"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="18" id="cell-icon-h"/>
                                                            <constraint firstAttribute="width" constant="18" id="cell-icon-w"/>
                                                        </constraints>
                                                        <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageScaling="proportionallyDown" image="NSActionTemplate" id="cell-icon-cell"/>
                                                    </imageView>
                                                    <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="cell-label">
                                                        <rect key="frame" x="36" y="8" width="286" height="17"/>
